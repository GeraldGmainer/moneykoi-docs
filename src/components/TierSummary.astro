---
import TierBadge from './TierBadge.astro';
import Md from './Md.astro';
import { areas, resolvedCatalog } from '../lib/catalog';
import { groupBy } from '../lib/data';

const rows = await resolvedCatalog();
const headline = {
  free: 'The full budgeting app on one phone, no account needed',
  pro: 'Everything in Free, plus',
  cloud: 'Everything in Pro, plus',
} as const;
const tagline = {
  free: 'Free forever',
  pro: 'One-time purchase · the power features · works offline',
  cloud: 'Monthly, yearly or lifetime · sync, devices, shared books, web',
} as const;
const areaOrder = Object.keys(areas);
---

<div class="mk-tier-stack not-content">
  {
    (['free', 'pro', 'cloud'] as const).map((tier) => {
      const live = rows.filter((r) => r.tier === tier && r.status === 'live');
      const planned = rows.filter((r) => r.tier === tier && r.status === 'planned');
      const byArea = groupBy(live, (r) => r.area).sort(([a], [b]) => areaOrder.indexOf(a) - areaOrder.indexOf(b));
      return (
        <section class={`mk-tier-card mk-tier-card-${tier}`}>
          <header class="mk-tier-head">
            <TierBadge tier={tier} />
            <strong>{headline[tier]}</strong>
            <span class="mk-muted">{tagline[tier]}</span>
            <span class="mk-tier-count">{live.length} features</span>
          </header>
          <div class="mk-tier-areas">
            {byArea.map(([area, items]) => (
              <div class="mk-tier-area">
                <h4>{areas[area] ?? area}</h4>
                <ul>
                  {items.map((r) => (
                    <li>
                      {r.docs ? <a href={`/${r.docs}/`}>{r.name}</a> : r.name}
                      {r.note && <span class="mk-note"><Md text={r.note} inline /></span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          {planned.length > 0 && <p class="mk-tier-planned">Planned: {planned.map((r) => r.name).join(' · ')}</p>}
        </section>
      );
    })
  }
</div>
