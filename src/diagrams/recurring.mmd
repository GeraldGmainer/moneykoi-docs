  resume["app resume"] -- "invokes for the open book" --> fn
  booking -- "sync_all" --> phone["phones and web"]
  rule -. "future dates" .-> proj["RecurrenceProjector<br/>never stored, never in balances"]
  rule -- "book without an account" --> local["MaterializeRecurringLocallyUseCase<br/>the server's generator, step for step"]
